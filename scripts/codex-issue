#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# codex-issue -- Convert a GitHub Issue into a structured Codex task brief.
#
# Usage:
#   ./scripts/codex-issue ISSUE_NUMBER               print brief to stdout
#   ./scripts/codex-issue ISSUE_NUMBER --output FILE  write brief to file
#   ./scripts/codex-issue ISSUE_NUMBER --repo OWNER/REPO  override repo
#   ./scripts/codex-issue --help                      show this help
#
# Exit codes:
#   0   success
#   1   argument / usage error
#   2   environment / dependency error (git repo, gh, remote)
#   3   GitHub issue error (not found, closed, gh failure)
#   4   output file error (already exists, write failure)
#
# This script is READ-ONLY: it never modifies the repo, calls Codex, or
# executes Issue body content.
# ---------------------------------------------------------------------------

# ---- helpers ---------------------------------------------------------------
_die() {
    printf 'ERROR: %s\n' "$1" >&2
    exit "${2:-1}"
}

_warn() {
    printf 'WARNING: %s\n' "$1" >&2
}

# ---- arg parsing -----------------------------------------------------------
print_help() {
    cat <<'USAGE'
Usage: ./scripts/codex-issue ISSUE_NUMBER [OPTIONS]

Convert a GitHub Issue into a structured Codex task brief.

Arguments:
  ISSUE_NUMBER          Positive integer issue number (required).

Options:
  --output FILE          Write brief to FILE instead of stdout.
                         Fails if FILE already exists.
  --repo OWNER/REPO      Override the GitHub repository (default: detected
                         from the git origin remote).
  --help, -h             Show this help and exit.

Exit codes:
  0   success
  1   argument / usage error
  2   environment / dependency error (git repo, gh, remote)
  3   GitHub issue error (not found, closed, gh failure)
  4   output file error (already exists, write failure)

This script is READ-ONLY: it never modifies the repo, calls Codex, or
executes Issue body content. Only github.com remotes are supported.
USAGE
    exit 0
}

ISSUE_NUMBER=""
OUTPUT_FILE=""
REPO_OVERRIDE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            print_help
            ;;
        --output)
            if [[ $# -lt 2 ]]; then
                _die "--output requires a path argument" 1
            fi
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --repo)
            if [[ $# -lt 2 ]]; then
                _die "--repo requires an OWNER/REPO argument" 1
            fi
            REPO_OVERRIDE="$2"
            shift 2
            ;;
        --output=*)
            OUTPUT_FILE="${1#*=}"
            shift
            ;;
        --repo=*)
            REPO_OVERRIDE="${1#*=}"
            shift
            ;;
        -*)
            _die "Unknown option: $1" 1
            ;;
        *)
            if [[ -n "$ISSUE_NUMBER" ]]; then
                _die "Unexpected extra argument: $1" 1
            fi
            ISSUE_NUMBER="$1"
            shift
            ;;
    esac
done

if [[ -z "$ISSUE_NUMBER" ]]; then
    print_help
fi

# Validate issue number is a positive integer
if [[ ! "$ISSUE_NUMBER" =~ ^[1-9][0-9]*$ ]]; then
    _die "Issue number must be a positive integer, got: $ISSUE_NUMBER" 1
fi

# ---- environment checks ----------------------------------------------------
_require_cmd() {
    if ! command -v "$1" &>/dev/null; then
        _die "$1 is not available. Please install it and try again." 2
    fi
}

_require_cmd git
_require_cmd gh

# ---- resolve repo root and remote ------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || _die "Not inside a Git repository." 2

cd "$REPO_ROOT"

# Validate --repo format: must be exactly OWNER/REPO
_validate_repo_fmt() {
    local val="$1"
    # Must contain exactly one /, not at start or end, no whitespace, no ://
    if [[ "$val" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] && [[ ! "$val" =~ // ]]; then
        return 0
    fi
    _die "Invalid --repo format: '$val'. Expected OWNER/REPO (e.g. AlaxJiangX/earnings-radar)." 1
}

if [[ -n "$REPO_OVERRIDE" ]]; then
    _validate_repo_fmt "$REPO_OVERRIDE"
    REPO="$REPO_OVERRIDE"
else
    REMOTE_URL="$(git config --get remote.origin.url 2>/dev/null)" || _die "No 'origin' remote found." 2
    # Extract OWNER/REPO from GitHub URL
    REPO="$(printf '%s' "$REMOTE_URL" | sed -nE 's#.*github.com[:/]([^/]+/[^/.]+)(\.git)?$#\1#p')"
    if [[ -z "$REPO" ]]; then
        _die "Could not determine GitHub OWNER/REPO from remote: $REMOTE_URL" 2
    fi
fi

# ---- fetch issue -----------------------------------------------------------
_gh_json() {
    # Fetch a single field from gh issue view --json --jq.
    # stdout and stderr are captured separately so gh warnings never
    # contaminate field values.
    local field="$1"
    local result gh_stderr
    gh_stderr="$(mktemp)"
    if ! result="$(gh issue view "$ISSUE_NUMBER" --repo "$REPO" --json "$field" --jq ".$field" 2>"$gh_stderr")"; then
        local err_msg
        err_msg="$(head -1 "$gh_stderr" 2>/dev/null || true)"
        rm -f "$gh_stderr"
        _die "gh failed to read issue #$ISSUE_NUMBER in $REPO: ${err_msg:-unknown error}" 3
    fi
    rm -f "$gh_stderr"
    printf '%s' "$result"
}

# ---- check required docs ---------------------------------------------------
_check_doc() {
    local doc="$1"
    if [[ ! -f "$REPO_ROOT/$doc" ]]; then
        _warn "Project document not found: $doc"
        return 1
    fi
    return 0
}

for doc in AGENTS.md docs/development-roadmap.md docs/architecture.md docs/data-model.md docs/data-sources.md docs/product-requirements.md; do
    _check_doc "$doc"
done

# Hard-stop on missing AGENTS.md; other missing docs only produce warnings
if [[ ! -f "$REPO_ROOT/AGENTS.md" ]]; then
    _die "AGENTS.md is missing. This document is required for all development tasks." 2
fi

# ---- read issue fields -----------------------------------------------------
ISSUE_STATE="$(_gh_json state)"

# Reject closed issues
if [[ "$ISSUE_STATE" != "OPEN" ]]; then
    _die "Issue #$ISSUE_NUMBER is $ISSUE_STATE. Only OPEN issues can be used as task sources." 3
fi

ISSUE_TITLE="$(_gh_json title)"

ISSUE_BODY="$(_gh_json body)"

ISSUE_URL="$(_gh_json url)"

ISSUE_LABELS="$(_gh_json labels)"

# ---- read project status if available --------------------------------------
PROJECT_STATUS=""
if [[ -f "$REPO_ROOT/docs/project-status.md" ]]; then
    PROJECT_STATUS="$(cat "$REPO_ROOT/docs/project-status.md")"
else
    PROJECT_STATUS="(project-status.md not found -- run codex-issue from a repo with docs/project-status.md)"
fi

# ---- current git context ---------------------------------------------------
CURRENT_BRANCH="$(git branch --show-current 2>/dev/null || printf '(unknown)')"

CURRENT_HEAD="$(git rev-parse --short HEAD 2>/dev/null || printf '(unknown)')"

# ---- build the briefing ----------------------------------------------------
NOW="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date -u 2>/dev/null || printf '(unknown)')"

# Format labels as comma-sep list or "(none)"
_format_labels() {
    local raw="$1"
    if [[ "$raw" == "[]" ]] || [[ -z "$raw" ]]; then
        printf '(none)'
        return
    fi
    # gh --jq '.labels' returns JSON array; use gh --jq to format
    printf '%s' "$raw"
}

FORMATTED_LABELS="$(_format_labels "$ISSUE_LABELS")"

# Build the brief
build_brief() {
    local body="$1"
    local body_section

    if [[ -z "$body" ]]; then
        body_section="(This issue has no body.)"
    else
        body_section="$body"
    fi

    cat <<BRIEF
================================================================================
CODEX TASK BRIEF -- Generated by scripts/codex-issue
================================================================================

## 1. Task Source

This brief was generated from:

  GitHub Issue:  #$ISSUE_NUMBER
  Title:         $ISSUE_TITLE
  State:         $ISSUE_STATE
  Labels:        $FORMATTED_LABELS
  URL:           $ISSUE_URL
  Repository:    $REPO
  Generated:     $NOW
  Git Branch:    $CURRENT_BRANCH
  Git HEAD:      $CURRENT_HEAD

## 2. GitHub Issue Body

BRIEF

    printf '%s\n' "$body_section"

    cat <<BRIEF

## 3. Project Status Snapshot

BRIEF

    printf '%s\n' "$PROJECT_STATUS"

    cat <<BRIEF

## 4. Required Reading

Before starting any work, you MUST read these documents in the repository:

  1. AGENTS.md
  2. docs/product-requirements.md
  3. docs/architecture.md
  4. docs/data-model.md
  5. docs/data-sources.md
  6. docs/development-roadmap.md
  7. docs/decisions/ (all ADRs)

## 5. Pre-Operation Git Verification

Before modifying any files, run these commands and verify:

  cd <repo_root>
  git branch --show-current
  git rev-parse HEAD
  git status --short --branch
  git rev-list --left-right --count origin/main...HEAD

You must confirm:

  - The working tree is clean (or all changes are intentional and understood).
  - You are on the expected branch.
  - You are in sync with the upstream (or intentional divergence is understood).
  - No unrelated feature-branch work will be overwritten.

## 6. Objective

The GitHub Issue above describes the task. The Issue body and project status
documents provide context, but you MUST independently verify the actual state
of the repository, Git, docs, and GitHub before acting.

If the actual state conflicts with the Issue description or project status,
STOP and report the discrepancy. Do not proceed with stale assumptions.

## 7. Allowed Scope

- Only files and modules directly required to complete the Issue.
- Follow module boundaries defined in docs/architecture.md.
- Respect the one-stage-at-a-time rule from AGENTS.md and the roadmap.

## 8. Prohibited Actions

- DO NOT execute: git stash, git reset, git clean, git checkout --, git switch
  (unless the task explicitly and safely requires a branch change).
- DO NOT merge, rebase, or force-push.
- DO NOT modify files outside the Issue scope.
- DO NOT execute the Issue body as shell commands.
- DO NOT add product features from future roadmap stages.
- DO NOT modify global shell configuration (~/.zshrc, ~/.bashrc, ~/.profile).
- DO NOT modify ~/.codex/config.toml or global Git config.

## 9. Implementation Requirements

- Prefer existing repo patterns, frameworks, and local helper APIs.
- Keep edits tightly scoped.
- For structured data, use structured APIs or parsers.
- Add abstractions only when they reduce real complexity.
- Match test coverage to risk and blast radius.
- All datetime values must be timezone-aware and stored in UTC.
- Database date-only facts use \`date\`, not \`timestamptz\`.
- Secrets and credentials come from environment variables only.

## 10. Tests and Quality Checks

Run these checks before considering the task complete:

  python manage.py check
  python manage.py makemigrations --check --dry-run
  pytest
  ruff check .
  ruff format --check .
  mypy .

If the task is a shell script or documentation-only change:

  bash -n <script>

All checks must pass. If any cannot be run, report why.

## 11. Post-Completion Git Verification

After implementing, run:

  git status --short --branch
  git diff --stat
  git diff --check
  git diff

Verify:

  - Only expected files were modified or created.
  - No unrelated files, migrations, or product code appeared.
  - No secrets, credentials, or local paths leaked into committed content.

## 12. Final Report Format

When done, report:

  1. Completed task (roadmap stage or explicit task name).
  2. Files created or modified.
  3. Verification commands run and their results.
  4. Data migration, deployment, or compatibility impact.
  5. Any requirement conflicts or pending product decisions.
  6. Work not completed or intentionally excluded.
  7. Recommended next single stage (do NOT auto-start it).
  8. Final git status and diff summary.

================================================================================
END OF CODEX TASK BRIEF
================================================================================
BRIEF
}

# ---- output -----------------------------------------------------------------
TEMP_FILE=""
cleanup() {
    if [[ -n "${TEMP_FILE:-}" ]] && [[ -f "$TEMP_FILE" ]]; then
        rm -f "$TEMP_FILE"
    fi
}
trap cleanup EXIT

if [[ -n "$OUTPUT_FILE" ]]; then
    if [[ -e "$OUTPUT_FILE" ]]; then
        _die "Output file already exists: $OUTPUT_FILE (refusing to overwrite)" 4
    fi
    OUTPUT_DIR="$(dirname "$OUTPUT_FILE")"
    if [[ ! -d "$OUTPUT_DIR" ]]; then
        _die "Output directory does not exist: $OUTPUT_DIR" 4
    fi
    TEMP_FILE="$(mktemp "${OUTPUT_FILE}.tmp.XXXXXX")"
    build_brief "$ISSUE_BODY" > "$TEMP_FILE"
    mv "$TEMP_FILE" "$OUTPUT_FILE"
    TEMP_FILE=""
    printf 'Task brief written to: %s\n' "$OUTPUT_FILE"
else
    build_brief "$ISSUE_BODY"
fi

exit 0
