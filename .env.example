DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-local-development-key
AUDIT_IP_HASH_KEY=replace-with-a-local-audit-ip-hash-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_DB=earnings_radar
POSTGRES_USER=earnings_radar
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

WEB_PORT=8000
RAW_DATA_MAX_PAYLOAD_BYTES=1048576
SEC_USER_AGENT=
SEC_MAX_REQUESTS_PER_SECOND=4
EARNINGS_CALENDAR_STALE_AFTER_SECONDS=1800

# Stage 7.1: public GitHub entry point shown in the nav and on the home page.
# Empty value falls back to the upstream repository URL.
GITHUB_URL=

# Stage 6.4 email delivery (ADR-027 D1): generic SMTP; the send command
# refuses to run when EMAIL_HOST / DEFAULT_FROM_EMAIL are empty.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=

# Stage 8.1 production deployment (docs/deployment.md).  Local compose
# keeps the component POSTGRES_* variables above; a managed-PaaS DATABASE_URL
# takes precedence over them when set.  Leave empty locally.
DATABASE_URL=
# Comma-separated https:// origins allowed for CSRF POSTs behind the PaaS
# edge proxy (e.g. https://your-app.up.railway.app).  Empty is fine locally.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production-only hardening (applied automatically outside development/test;
# listed here for visibility and override).
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SECURE_HSTS_SECONDS=3600
# Single-container static file serving via whitenoise (package is in
# requirements.txt).  Local development keeps the default false; production
# sets true (docs/deployment.md §4).
# DJANGO_USE_WHITENOISE=false
